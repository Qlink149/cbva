# CLOUDFLARE edge mode (EDGE_MODE=cloudflare): browsers -> Cloudflare -> Caddy -> api. Kept for later use.
# Select it with CADDYFILE=./Caddyfile.cloudflare and the docker-compose.cloudflare.yml overlay (mounts the
# Cloudflare ranges and the Origin CA certificate). SITE_ADDRESS comes from the environment.
{
	# Cloudflare proxies to us, so only trust forwarded client IPs from Cloudflare's edge ranges.
	# /etc/caddy/cloudflare-ips.conf is generated by refresh-cloudflare-ips.sh from the SAME list that
	# drives the ufw 80/443 rules (seed copy: deploy/cloudflare-ips.conf).
	servers {
		import /etc/caddy/cloudflare-ips.conf
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_ADDRESS} {
	# TLS: with ufw limiting 80/443 to Cloudflare, Let's Encrypt HTTP-01/TLS-ALPN validation cannot reach
	# this host, so use a Cloudflare Origin CA certificate (Cloudflare dashboard -> SSL/TLS -> Origin Server),
	# mounted from /opt/cbva/certs, with SSL mode "Full (strict)".
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	reverse_proxy api:8000 {
		health_uri /health/ready
		health_interval 30s
		health_timeout 5s
		# Pass the Cloudflare-verified client IP to the app (limiter reads CF-Connecting-IP).
		header_up CF-Connecting-IP {client_ip}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}
