# Copy to .env (chmod 600) and fill in. Never commit .env.
# --- environment ---
ENV=prod                      # dev | prod  (prod disables /docs, /redoc, /openapi.json)
TZ=Asia/Kolkata

# --- required ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=cbva
DATABASE_NAME=cbva
# >= 32 chars, random. The app refuses to start otherwise.  Generate: openssl rand -hex 32
SECRET_KEY=
# Exact frontend origin(s), comma-separated, no wildcard. Preview (*.pages.dev) origins are NOT allowed.
FRONTEND_ORIGIN=https://app.example.com

# --- optional ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Leave unset/empty in production.
CORS_ORIGIN_REGEX=

# --- first-run only: python -m app.cli bootstrap ---
# Password must be >= 12 chars. Remove both lines from .env after the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- never set in production ---
# MONGODB_URL_PROD_READ=  PROD_DATABASE_NAME=  MIGRATION_WRITE_DATABASE_NAME=  VERCEL=
